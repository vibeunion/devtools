{
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "baseUrl": "../..",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@vibeunion/devtools-protocol": ["packages/protocol/dist/index.d.ts"]
    },
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
