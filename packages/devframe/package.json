{
  "name": "@vibeunion/devtools-devframe",
  "version": "0.1.0",
  "description": "Devframe transport contracts and helpers for VibeUnion DevTools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bun build src/index.ts --outdir dist --target browser && tsc -b tsconfig.json --force",
    "test": "bun test"
  },
  "dependencies": {
    "@vibeunion/devtools-protocol": "workspace:*",
    "devframe": "1.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/vibeunion/devtools.git",
    "directory": "packages/devframe"
  }
}
